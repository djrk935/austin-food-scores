{
  "base": "https://tiles.openfreemap.org/styles/positron",
  "paint": {
    "background":             { "background-color": "#f2f2f2" },
    "park":                   { "fill-color": "#ebebeb" },
    "landcover_wood":         { "fill-color": "#ebebeb" },
    "landuse_residential":    { "fill-color": "#eeeeee" },
    "water":                  { "fill-color": "#d6d6d6" },
    "waterway":               { "line-color": "#cfcfcf" },
    "building":               { "fill-color": "#dcdcdc", "fill-outline-color": "#c8c8c8" },
    "road_area_pier":         { "fill-color": "#f2f2f2" },
    "road_pier":              { "line-color": "#f2f2f2" },
    "water_name_point_label": { "text-color": "#6b6b6b" },
    "water_name_line_label":  { "text-color": "#6b6b6b" },
    "highway-name-path":      { "text-halo-color": "#ffffff" }
  },
  "hide": ["highway-shield-non-us", "highway-shield-us-interstate", "road_shield_us"],
  "add": [{
    "before": "waterway_line_label",
    "layer": {
      "id": "building-3d", "type": "fill-extrusion", "source": "openmaptiles", "source-layer": "building",
      "minzoom": 12.5, "filter": ["!", ["has", "hide_3d"]],
      "paint": {
        "fill-extrusion-color": "#e6e6e6",
        "fill-extrusion-height": ["interpolate", ["linear"], ["zoom"], 12.5, 0, 13.5, ["coalesce", ["get", "render_height"], 0]],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 1,
        "fill-extrusion-vertical-gradient": false
      }
    }
  }],
  "light": { "anchor": "viewport", "color": "#ffffff", "intensity": 0.15, "position": [1.15, 210, 30] }
}
